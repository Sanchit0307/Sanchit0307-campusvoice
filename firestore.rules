rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /ideas/{ideaId} {
      // 1. Prototype public read access for ideas feed and idea details
      allow read: if true;

      // 2. Prototype public create access with strict schema and field validation
      allow create: if isValidIdea();

      // 3. Deny client-side updates and deletes (reserved for future auth & moderation issues)
      allow update, delete: if false;

      // Validation function for incoming idea documents
      function isValidIdea() {
        let data = request.resource.data;

        // Exactly the 9 fields produced by src/services/ideasService.js createIdea()
        let requiredKeys = [
          'title',
          'description',
          'category',
          'authorId',
          'authorName',
          'status',
          'upvoteCount',
          'createdAt',
          'updatedAt'
        ];

        // Valid categories matching src/data/mockIdeas.js IDEA_CATEGORIES
        let allowedCategories = [
          'Academics',
          'Campus Life',
          'Dining',
          'Facilities',
          'Sustainability',
          'Transportation',
          'Wellness'
        ];

        return data.keys().hasAll(requiredKeys)
          && data.keys().hasOnly(requiredKeys)
          && data.title is string
          && data.title.size() >= 5
          && data.title.size() <= 100
          && data.description is string
          && data.description.size() >= 20
          && data.description.size() <= 500
          && data.category in allowedCategories
          && data.status == 'Submitted'
          && data.upvoteCount == 0
          && (data.authorId == null || (data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128))
          && data.authorName is string
          && data.authorName.size() >= 2
          && data.authorName.size() <= 100
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      // ===============================================================
      // VOTES SUBCOLLECTION: ideas/{ideaId}/votes/{userId}
      // ===============================================================
      match /votes/{userId} {
        // 1. Public read for vote documents (required for getCountFromServer aggregation & checking vote state)
        // NOTE: Exposes voter UIDs for the MVP to allow client aggregation without a trusted backend.
        allow read: if true;

        // 2. Authenticated user can ONLY create their own vote document
        allow create: if isValidVote(userId);

        // 3. Deny client updates completely (votes are toggle-only, cannot be edited)
        allow update: if false;

        // 4. Authenticated user can ONLY delete their own vote document (toggle unvote)
        allow delete: if request.auth != null && request.auth.uid == userId;

        // Validation function for incoming vote documents
        function isValidVote(ownerId) {
          let data = request.resource.data;
          let voteRequiredKeys = ['userId', 'createdAt'];

          return request.auth != null
            && request.auth.uid == ownerId
            && data.keys().hasAll(voteRequiredKeys)
            && data.keys().hasOnly(voteRequiredKeys)
            && data.userId == ownerId
            && data.createdAt is timestamp;
        }
      }
    }
  }
}
