rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and role authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isModerator() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid))
        && (
          ('role' in get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data
            && (get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.role == 'moderator'
                || get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.role == 'Moderator'))
          || ('Role' in get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data
            && (get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.Role == 'moderator'
                || get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.Role == 'Moderator'))
        );
    }

    // ===============================================================
    // MODERATORS COLLECTION: moderators/{userId}
    // Client writes are completely denied to prevent privilege escalation.
    // Authenticated users can read moderator records to determine their role.
    // ===============================================================
    match /moderators/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ===============================================================
    // IDEAS COLLECTION: ideas/{ideaId}
    // ===============================================================
    match /ideas/{ideaId} {
      // 1. Prototype public read access for ideas feed and idea details
      allow read: if true;

      // 2. Prototype public create access with strict schema and field validation
      allow create: if isValidIdea();

      // 3. Allow only authorized moderators to update idea workflow status
      allow update: if isModerator() && isValidStatusUpdate();

      // 4. Allow only authorized moderators to remove ideas permanently
      allow delete: if isModerator();

      // Validation function for incoming idea documents on proposal creation
      function isValidIdea() {
        let data = request.resource.data;

        // Exactly the 9 fields produced by src/services/ideasService.js createIdea()
        let requiredKeys = [
          'title',
          'description',
          'category',
          'authorId',
          'authorName',
          'status',
          'upvoteCount',
          'createdAt',
          'updatedAt'
        ];

        // Valid categories matching src/data/mockIdeas.js IDEA_CATEGORIES
        let allowedCategories = [
          'Academics',
          'Campus Life',
          'Dining',
          'Facilities',
          'Sustainability',
          'Transportation',
          'Wellness'
        ];

        return data.keys().hasAll(requiredKeys)
          && data.keys().hasOnly(requiredKeys)
          && data.title is string
          && data.title.size() >= 5
          && data.title.size() <= 100
          && data.description is string
          && data.description.size() >= 20
          && data.description.size() <= 500
          && data.category in allowedCategories
          && data.status == 'Submitted'
          && data.upvoteCount == 0
          && (data.authorId == null || (data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128))
          && data.authorName is string
          && data.authorName.size() >= 2
          && data.authorName.size() <= 100
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      // Validation function for moderator status transitions
      function isValidStatusUpdate() {
        let incoming = request.resource.data;
        let existing = resource.data;
        let diff = incoming.diff(existing);
        let allowedStatuses = [
          'Submitted',
          'Under Review',
          'In Progress',
          'Accepted',
          'Implemented',
          'Rejected'
        ];

        return diff.affectedKeys().hasOnly(['status', 'updatedAt'])
          && diff.affectedKeys().hasAny(['status'])
          && incoming.status in allowedStatuses
          && incoming.updatedAt == request.time;
      }

      // ===============================================================
      // VOTES SUBCOLLECTION: ideas/{ideaId}/votes/{userId}
      // ===============================================================
      match /votes/{userId} {
        // 1. Public read for vote documents (required for getCountFromServer aggregation & checking vote state)
        // NOTE: Exposes voter UIDs for the MVP to allow client aggregation without a trusted backend.
        allow read: if true;

        // 2. Authenticated user can ONLY create their own vote document
        allow create: if isValidVote(userId);

        // 3. Deny client updates completely (votes are toggle-only, cannot be edited)
        allow update: if false;

        // 4. Authenticated user can delete their own vote document (toggle unvote), or an authorized moderator cleaning up idea votes
        allow delete: if (request.auth != null && request.auth.uid == userId) || isModerator();

        // Validation function for incoming vote documents
        function isValidVote(ownerId) {
          let data = request.resource.data;
          let voteRequiredKeys = ['userId', 'createdAt'];

          return request.auth != null
            && request.auth.uid == ownerId
            && data.keys().hasAll(voteRequiredKeys)
            && data.keys().hasOnly(voteRequiredKeys)
            && data.userId == ownerId
            && data.createdAt is timestamp;
        }
      }
    }
  }
}
